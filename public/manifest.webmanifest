{
  "id": "/",
  "name": "Sistema Melero Nutri",
  "short_name": "Melero Nutri",
  "description": "Sistema de Gestão Nutricional, Prontuário Clínico e Planos Alimentares Inteligentes",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#f8fafc",
  "theme_color": "#059669",
  "orientation": "portrait-primary",
  "lang": "pt-BR",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": [
    "medical",
    "health",
    "productivity",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/leaf.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Painel Principal",
      "short_name": "Dashboard",
      "description": "Acessar resumo de consultas e métricas",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Lista de Pacientes",
      "short_name": "Pacientes",
      "description": "Consultar prontuários cadastrados",
      "url": "/pacientes",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Novo Paciente",
      "short_name": "Cadastrar",
      "description": "Cadastrar novo paciente clínico",
      "url": "/pacientes/novo",
      "icons": [
        {
          "src": "/icons/icon-192.png",
